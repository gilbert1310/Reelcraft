# Shared secret: Supabase edge functions send this in the x-api-key header.
REELCRAFT_API_KEY=generate-a-long-random-string
# Shared secret: this service sends it back to the reelcraft-callback edge function.
REELCRAFT_CALLBACK_SECRET=generate-another-long-random-string
# Only POST results to your own callback function.
CALLBACK_URL_PREFIX=https://YOUR-PROJECT.supabase.co/functions/v1/reelcraft-callback

ANTHROPIC_API_KEY=sk-ant-...
VISION_PROVIDER=anthropic
VISION_MODEL=claude-opus-5-5
VISION_EFFORT=medium

EMBEDDER=clip
GROUP_THRESHOLD=0.85
MAX_CONCURRENT_JOBS=2
